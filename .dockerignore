# Keep the build context small and never bake host-only files into the image.
node_modules
dist
npm-debug.log*

.git
.gitignore

# Generated by docker/explorer-rpc/entrypoint.sh from env vars at startup.
config.json

# Thumbnail cache written by thumbnail.js at runtime.
images

# Other services' build folders and the compose files aren't part of the
# explorer image; only the explorer entrypoint is copied in.
docker/node
docker/rpc-proxy
docker/docker-compose.yml
docker/.env*
docker/explorer-rpc/Dockerfile

*.md
.dockerignore
