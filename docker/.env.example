# Template for docker/.env — copy it next to docker-compose.yml:
#     cp .env.example .env
# .env is ignored by git, so your values survive a `git pull`. Every value has
# the same default in docker-compose.yml, so the stack also starts without it.

# ── Node RPC ─────────────────────────────────────────────────────────────────
# Used by neuraid AND by wallet-services, so the two always agree. The node
# rewrites its neurai.conf on every start: a change applies on the next
# `docker compose up -d`. Change the password.
NODE_RPC_USER=neurai
NODE_RPC_PASSWORD=changeme

# ── Explorer's RPC key ───────────────────────────────────────────────────────
# The explorer sends it as its RPC password, and wallet-services recognises it
# as a trusted client: no per-IP request limit, plus gettxoutsetinfo for the
# coins in circulation. Letters and digits only (it is placed inside JSON),
# at least 16 characters, e.g. `openssl rand -hex 24`.
EXPLORER_RPC_KEY=change-this-explorer-key

# ── Pinned sources ───────────────────────────────────────────────────────────
# Commits the node (NeuraiProject/Neurai, branch DePIN-Test) and wallet-services
# (NeuraiProject/neurai-wallet-services) are built from. Docker only rebuilds
# them when these change: bump them to update, then `docker compose up -d --build`.
# A node commit with another testnet genesis also needs NEURAI_EXPECTED_GENESIS
# changed in docker-compose.yml, or wallet-services refuses the node.
# WALLET_SERVICES_SOURCE_COMMIT must be the full 40-character lowercase hash.
NODE_SOURCE_COMMIT=7f1773e538c210212441bd723eb8ea3ba99a00ef
WALLET_SERVICES_SOURCE_COMMIT=892278f4e3cde2c1397abceea3fbbfac1eec5935
